# Example template — copy to application.properties for local dev (real file is gitignored).
spring.application.name=nyare
spring.profiles.active=dev,google

# Test AI provider group: activating the test profile also pulls the provider
# profile. Swap the single word to switch providers (groq | google).
spring.profiles.group.test=groq

# Server
server.port=${SPRING_BOOT_PORT:8080}

# SQLite DataSource
spring.datasource.url=jdbc:sqlite:nyare.db
spring.datasource.driver-class-name=org.sqlite.JDBC

# HikariCP Configuration for SQLite
spring.datasource.hikari.maximum-pool-size=1

# Hibernate / JPA
spring.jpa.database-platform=org.hibernate.community.dialect.SQLiteDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# Jackson 3 / Spring Boot 4
spring.jackson.deserialization.fail-on-null-for-primitives=false

# Centralized AI Parameters
nyare.ai.temperature=0.1
nyare.ai.top-p=0.8
nyare.ai.max-tokens=4096

# Default AI Provider (google-genai)
spring.ai.model.chat=google-genai

# Controller
nyare.study-planner.sse-timeout-ms=60000

# AI model request timeout (keep below sse-timeout-ms so slow-model timeouts surface as SSE error events)
nyare.study-planner.ai-timeout-ms=50000
nyare.image-processor.ai-timeout-ms=30000
