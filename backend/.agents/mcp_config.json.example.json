{
    "mcpServers": {
        "intellij": {
            "$typeName": "McpServer",
            "command": "npx",
            "args": [
                "-y",
                "@jetbrains/mcp-proxy"
            ],
            "disabled": false
        },
        "spring-docs": {
            "command": "npx",
            "args": [
                "@enokdev/springdocs-mcp@latest"
            ],
            "description": "Spring Documentation MCP Server with 12 powerful tools"
        }
    }
}