{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./.agents/plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "./.agents/plugins/superpowers/.opencode/plugins/superpowers.js"
  ],
  "skills": {
    "paths": ["./.agents/plugins/ponytail/skills", "./.agents/plugins/superpowers/skills"]
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    }
  },
  "instructions": [".agents/rules/*.md"]
}
