{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "../.agents/plugins/ponytail/.opencode/plugins/ponytail.mjs",
    "../.agents/plugins/superpowers/.opencode/plugins/superpowers.js"
  ],
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn-vue@latest", "mcp"],
      "enabled": true
    },
    "schedule-x": {
      "type": "local",
      "command": ["npx", "-y", "@schedule-x/mcp"],
      "enabled": true
    },
    "vue-docs": {
      "type": "remote",
      "url": "https://mcp.vue-mcp.org/mcp",
      "enabled": true
    }
  }
}
